# Goldenstore Cloudflare Workers environment example.
# Copy this to .dev.vars for local Wrangler development. Never commit real values.

# Store configuration (non-secrets)
STORE_NAME=Goldenstore
STORE_DOMAIN=goldenstore.online
STORE_LOGO_URL=https://goldenstore.online/images/logo.png
ALLOWED_ORIGINS=https://goldenstore.online,https://www.goldenstore.online,https://goldenstore-new.pages.dev
ADMIN_USERNAME=admin

# Worker secrets: set with `npx wrangler secret put NAME` for production.
ADMIN_PASSWORD=replace-locally
JWT_SECRET=replace-with-a-long-random-secret

# Firebase service account credentials.
# Preferred: complete service-account JSON in one secret.
FIREBASE_SERVICE_ACCOUNT=
# Or set the fields separately instead of FIREBASE_SERVICE_ACCOUNT:
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-service-account-email
FIREBASE_PRIVATE_KEY=replace-with-private-key-pem
# Optional alternative when using a base64-encoded PEM:
FIREBASE_PRIVATE_KEY_BASE64=
# Firebase Web API key is public config but is used by accounts:lookup REST calls.
FIREBASE_API_KEY=replace-with-firebase-web-api-key

# Cloudflare R2
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=goldenstore-apks
R2_PUBLIC_URL=https://replace-with-public-r2-domain
